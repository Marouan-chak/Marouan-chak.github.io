<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description | escape }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="theme-color" content="#0a0b0d">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Blog" href="{{ site.url }}/blog/rss.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/blog/assets/blog.css">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/blog/crossplane-python-blog-posts/images/covers/part-01-cover.webp">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | {{ site.name }}">
  <meta name="twitter:description" content="{{ description | escape }}">
  <meta name="twitter:image" content="{{ site.url }}/blog/crossplane-python-blog-posts/images/covers/part-01-cover.webp">

  {% set series = collections.crossplanePythonSeries %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": "{{ title }}",
      "description": "{{ description | escape }}",
      "url": "{{ site.url }}{{ page.url }}",
      "numberOfItems": {{ series.length }},
      "itemListElement": [
        {% for post in series %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}{{ post.url }}",
          "name": "{{ post.data.title | escape }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  </script>
</head>
<body>
  <nav>
    <div class="container">
      <a href="/" class="logo">marouan<span>.net</span></a>
      <ul class="nav-links" id="site-nav">
        <li><a href="/#problems">Approach</a></li>
        <li><a href="/#work">Case Studies</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#experience">Log</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation">
        ☰
      </button>
    </div>
  </nav>

  <main class="container" style="padding-top: var(--space-4);">
    <section class="hero">
      <div class="kicker">Series Index</div>
      <h1>{{ title }}</h1>
      <p>{{ description }}</p>
    </section>

    <section class="listing">
      {% set series = collections.crossplanePythonSeries %}
      {% for post in series %}
      <article class="listing-item">
        <div class="listing-item-image">
          <span class="listing-item-badge">Part {{ post.data.part }}</span>
          {% if post.data.cover_image %}
          <img src="{{ post.data.cover_image }}" alt="{{ post.data.title }}" loading="lazy">
          {% endif %}
        </div>
        <div class="listing-item-content">
          <span class="mono-label">part_{{ "0" if post.data.part < 10 }}{{ post.data.part }}</span>
          <h2>{{ post.data.title }}</h2>
          <p>{{ post.data.description }}</p>
          <a href="{{ post.url }}" class="listing-item-link">
            Read article
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </article>
      {% endfor %}
    </section>
  </main>

  <footer>
    <div class="container">
      <p>© <span class="copyright-year">2026</span> marouan.net. platform systems for cloud native teams.</p>
    </div>
  </footer>

  <script>
    // Mobile Navigation Toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    const nav = document.querySelector('nav');

    if (navToggle && navLinks) {
      navToggle.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(isOpen));
        navToggle.textContent = isOpen ? '✕' : '☰';
      });
    }

    // Set dynamic year
    document.querySelector('.copyright-year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
