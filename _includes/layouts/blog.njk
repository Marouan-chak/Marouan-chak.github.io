<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description | escape }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="theme-color" content="#0a0b0d">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} Blog" href="{{ site.url }}/blog/rss.xml">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/blog/assets/blog.css">

  {% set postUrl %}{{ site.url }}{{ page.url }}{% endset %}

  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title | escape }}">
  <meta property="og:description" content="{{ description | escape }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if cover_image %}
  <meta property="og:image" content="{{ site.url }}{{ cover_image }}">
  {% endif %}
  {% if page.date %}
  <meta property="article:published_time" content="{{ page.date | dateIso }}">
  <meta property="article:modified_time" content="{{ page.date | dateIso }}">
  <meta property="article:author" content="{{ site.author }}">
  {% endif %}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | escape }}">
  <meta name="twitter:description" content="{{ description | escape }}">
  {% if cover_image %}
  <meta name="twitter:image" content="{{ site.url }}{{ cover_image }}">
  {% endif %}

  {% if page.date %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ postUrl | jsonLd | safe }}
      },
      "headline": {{ title | jsonLd | safe }},
      "description": {{ description | jsonLd | safe }},
      "author": {
        "@type": "Person",
        "name": {{ site.author | jsonLd | safe }},
        "url": {{ site.url | jsonLd | safe }}
      },
      "publisher": {
        "@type": "Person",
        "name": {{ site.author | jsonLd | safe }},
        "url": {{ site.url | jsonLd | safe }}
      },
      "datePublished": {{ page.date | dateIso | jsonLd | safe }},
      "dateModified": {{ page.date | dateIso | jsonLd | safe }},
      "url": {{ postUrl | jsonLd | safe }}
      {% if cover_image %},
      {% set coverImageUrl %}{{ site.url }}{{ cover_image }}{% endset %}
      "image": {
        "@type": "ImageObject",
        "url": {{ coverImageUrl | jsonLd | safe }}
      }
      {% endif %}
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://marouan.net/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://marouan.net/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Crossplane Python Functions",
          "item": "https://marouan.net/blog/crossplane-python-blog-posts/"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": {{ title | jsonLd | safe }},
          "item": {{ postUrl | jsonLd | safe }}
        }
      ]
    }
  </script>
  {% endif %}
</head>
<body>
  <nav>
    <div class="container">
      <a href="/" class="logo">marouan<span>.net</span></a>
      <ul class="nav-links" id="site-nav">
        <li><a href="/#problems">Approach</a></li>
        <li><a href="/#work">Case Studies</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#experience">Log</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Toggle navigation">
        ☰
      </button>
    </div>
  </nav>

  <main class="container" style="padding-top: var(--space-4);">
    <section class="hero">
      <div class="kicker">{{ series_title }}</div>
      <h1>{{ title }}</h1>
      <p>{{ description }}</p>
    </section>

    <article class="post-shell">
      <div class="post-meta">
        {% if part %}<span>Part {{ part }}</span>{% endif %}
        {% if page.date %}<span>{{ page.date | readableDate }}</span>{% endif %}
      </div>

      {% if cover_image %}
      <div class="post-cover">
        <img src="{{ cover_image }}" alt="Cover image for {{ title | escape }}">
      </div>
      {% endif %}

      <div class="post-content">
        {{ content | safe }}
      </div>

      {% set series = collections.crossplanePythonSeries %}
      {% set index = series | findIndexByUrl(page.url) %}
      {% if index != -1 %}
      <div class="series-nav">
        {% if index > 0 %}
        <a class="series-card prev" href="{{ series[index - 1].url }}">
          <span>Previous / Part {{ series[index - 1].data.part }}</span>
          <strong>{{ series[index - 1].data.title }}</strong>
        </a>
        {% else %}
        <div></div>
        {% endif %}
        {% if index + 1 < series.length %}
        <a class="series-card next" href="{{ series[index + 1].url }}">
          <span>Next / Part {{ series[index + 1].data.part }}</span>
          <strong>{{ series[index + 1].data.title }}</strong>
        </a>
        {% endif %}
      </div>
      {% endif %}
    </article>
  </main>

  <footer>
    <div class="container">
      <p>© <span class="copyright-year">2026</span> marouan.net. platform systems for cloud native teams.</p>
    </div>
  </footer>

  <script>
    // Mobile Navigation Toggle
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    const nav = document.querySelector('nav');

    if (navToggle && navLinks) {
      navToggle.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(isOpen));
        navToggle.textContent = isOpen ? '✕' : '☰';
      });
    }

    // Set dynamic year
    document.querySelector('.copyright-year').textContent = new Date().getFullYear();
  </script>
</body>
</html>
